# Turn an `nm` dump of lnFreeRTOS_structs_probe.c into freertos_struct.h and into
# the Rust constants of the in-tree kernel (rs_rtos/src/kernel/esprit/generated.rs).
#
# Called at build time from the freertos_struct_header target (lnFreeRTOS.cmake):
#   cmake -DNM=<nm> -DOBJ=<probe object> -DOUT=<header> -DRUST_OUT=<rust file> \
#         -DWHO=<board> -P lnFreeRTOS_structs.cmake
#
# Every symbol of the probe is an array whose size is what we want to know:
#   ln_freertos_size_<type>    -> sizeof(<type>)      -> FREERTOS_SIZEOF_<type>
#   ln_freertos_value_<config> -> <config> value      -> FREERTOS_VALUE_<config>
# Both outputs are only rewritten when their content changes, so a build that
# does not touch the kernel configuration touches nothing.

foreach(required NM OBJ OUT)
  if(NOT ${required})
    message(FATAL_ERROR "lnFreeRTOS_structs: -D${required} is required")
  endif()
endforeach()

if(NOT EXISTS "${OBJ}")
  message(FATAL_ERROR "lnFreeRTOS_structs: probe object ${OBJ} not found")
endif()

execute_process(COMMAND ${NM} --print-size --defined-only "${OBJ}" OUTPUT_VARIABLE nm_out RESULT_VARIABLE nm_rc
                ERROR_VARIABLE nm_err)
if(NOT nm_rc EQUAL 0)
  message(FATAL_ERROR "lnFreeRTOS_structs: ${NM} failed on ${OBJ}: ${nm_err}")
endif()

# nm gives `<address> <size> <type> <name>`; the size of the array is the value.
string(REPLACE "\n" ";" nm_lines "${nm_out}")
set(sizes "")
set(values "")
foreach(line IN LISTS nm_lines)
  if(line MATCHES "^[0-9a-fA-F]+ +([0-9a-fA-F]+) +[A-Za-z] +ln_freertos_(size|value)_([A-Za-z0-9_]+)$")
    math(EXPR amount "0x${CMAKE_MATCH_1}")
    if("${CMAKE_MATCH_2}" STREQUAL "size")
      list(APPEND sizes "${CMAKE_MATCH_3} ${amount}")
    else()
      list(APPEND values "${CMAKE_MATCH_3} ${amount}")
    endif()
  endif()
endforeach()

if(NOT sizes)
  message(FATAL_ERROR "lnFreeRTOS_structs: no ln_freertos_* symbol in ${OBJ}, is configSUPPORT_STATIC_ALLOCATION 1?")
endif()
list(SORT sizes)
list(SORT values)

# ---------------------------------------------------------------------------
# The Rust constants: rs_rtos/src/kernel/esprit/generated.rs
#
# rs_rtos sizes the .bss it hands to the *Static() API, and converts
# milliseconds to ticks, with numbers that describe the kernel it links.  They
# are *generated* here from the same measurement instead of being written by
# hand, so a FreeRTOSConfig.h change lands in the crate on the next build: a
# stale number is a silent .bss overrun, not a compile error.
#
# Write-if-different: an unchanged kernel leaves the file (and its mtime) alone,
# so cargo does not recompile on every build.  swindle/rs/CMakeLists.txt makes
# this target a prerequisite of the cargo build, so the file is final before the
# crate is read - a parallel build cannot compile the previous layout.
#
# The table below is the contract with the crate:
#   <measured symbol>|<Rust constant>|<Rust type>|<doc comment>
# The measured names come from lnFreeRTOS_structs_probe.c (`ln_freertos_size_<type>`
# and `ln_freertos_value_<macro>`); add a row when rs_rtos consumes one more number.
# ---------------------------------------------------------------------------
set(rust_consts
    "StaticQueue_t|STATIC_QUEUE_BYTES|usize|`sizeof(StaticQueue_t)`, which is also `sizeof(StaticSemaphore_t)`: the storage one static queue, mutex or semaphore costs."
    "StaticTimer_t|STATIC_TIMER_BYTES|usize|`sizeof(StaticTimer_t)`: the storage one statically created software timer (`crate::timer`) costs."
    "configTICK_RATE_HZ|TICK_RATE_HZ|u32|`configTICK_RATE_HZ`: how many ticks a second has (milliseconds -> ticks in `task.rs`).")

if(RUST_OUT)
  set(measured ${sizes} ${values})
  # Module docs are a plain list (no semicolons inside), joined below; the
  # constants themselves are appended to the string directly, because a Rust
  # statement ends with `;` and a CMake list would split it there.
  set(rust_header
      "//! FreeRTOS kernel constants of the kernel this crate is linked with,"
      "//! measured from that kernel by the build."
      "//!"
      "//! Generated by esprit/cmake/lnFreeRTOS_structs.cmake from"
      "//! esprit/cmake/lnFreeRTOS_structs_probe.c -- do not edit."
      "//!"
      "//! Every esprit build compiles the probe with its own flags and kernel"
      "//! configuration, reads the sizes back with nm and rewrites this file when a"
      "//! number changes (write-if-different, so an unchanged kernel leaves it - and"
      "//! cargo's fingerprint - alone).  The file is committed next to the kernel it"
      "//! describes for two reasons: the crate has to build with plain cargo, where"
      "//! no probe runs (it then holds the values of the last esprit build), and a"
      "//! change of the kernel layout should be visible in `git diff`."
      "//!"
      "//! This is the in-tree kernel (esprit/FreeRTOS).  The ESP-IDF kernel has"
      "//! different numbers and its own file, ../esp32.rs (see ../mod.rs).")
  string(REPLACE ";" "\n" rust_content "${rust_header}")
  string(APPEND rust_content "\n")

  set(rust_summary "")
  foreach(row IN LISTS rust_consts)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 measured_name)
    list(GET fields 1 rust_name)
    list(GET fields 2 rust_type)
    list(GET fields 3 rust_doc)

    set(measured_amount "")
    foreach(entry IN LISTS measured)
      string(REPLACE " " ";" entry_fields "${entry}")
      list(GET entry_fields 0 entry_name)
      if(entry_name STREQUAL measured_name)
        list(GET entry_fields 1 measured_amount)
      endif()
    endforeach()
    if(measured_amount STREQUAL "")
      message(FATAL_ERROR
              "lnFreeRTOS_structs: ${measured_name} is not measured by lnFreeRTOS_structs_probe.c, "
              "so ${rust_name} of ${RUST_OUT} cannot be generated")
    endif()

    string(APPEND rust_content "\n/// ${rust_doc}\npub const ${rust_name}: ${rust_type} = ${measured_amount};\n")
    string(APPEND rust_summary " ${rust_name}=${measured_amount}")
  endforeach()

  set(previous_rust "")
  if(EXISTS "${RUST_OUT}")
    file(READ "${RUST_OUT}" previous_rust)
  endif()
  if(NOT previous_rust STREQUAL rust_content)
    # Write through a temporary: a read-only tree then gives the message below
    # instead of a CMake file(WRITE) error, and a failure cannot leave a
    # half-written source file in the crate.
    set(tmp_rust "${CMAKE_CURRENT_BINARY_DIR}/lnFreeRTOS_kernel_rs.tmp")
    file(WRITE "${tmp_rust}" "${rust_content}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${tmp_rust}" "${RUST_OUT}"
                    RESULT_VARIABLE copy_rc OUTPUT_QUIET ERROR_VARIABLE copy_err)
    if(NOT copy_rc EQUAL 0)
      message(FATAL_ERROR
              "lnFreeRTOS_structs: cannot write ${RUST_OUT} - is the tree read-only?\n"
              "This kernel needs${rust_summary}. Put those values into that file by hand (or make the\n"
              "checkout writable): the build cannot link a firmware whose kernel constants are stale.\n"
              "(${copy_err})")
    endif()
    message(STATUS "lnFreeRTOS_structs: regenerated ${RUST_OUT}:${rust_summary}")
  endif()
endif()

set(lines
    "/*"
    " * FreeRTOS object sizes for this build."
    " * Generated by esprit/cmake/lnFreeRTOS_structs.cmake -- do not edit."
    " *"
    " * FREERTOS_SIZEOF_<type> is sizeof(<type>), i.e. the .bss a static object of"
    " * that kind costs (those are the buffers the *Static() API expects)."
    " * FREERTOS_VALUE_<config> is the value of a FreeRTOSConfig.h setting."
    " */"
    "#pragma once"
    "")

if(WHO)
  list(APPEND lines "/* ${WHO} */" "")
endif()

foreach(entry IN LISTS sizes)
  string(REPLACE " " ";" entry "${entry}")
  list(GET entry 0 name)
  list(GET entry 1 amount)
  list(APPEND lines "#define FREERTOS_SIZEOF_${name} ${amount}")
endforeach()

if(values)
  list(APPEND lines "")
  foreach(entry IN LISTS values)
    string(REPLACE " " ";" entry "${entry}")
    list(GET entry 0 name)
    list(GET entry 1 amount)
    list(APPEND lines "#define FREERTOS_VALUE_${name} ${amount}")
  endforeach()
endif()

string(REPLACE ";" "\n" content "${lines}")
string(APPEND content "\n")

set(previous "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL content)
  file(WRITE "${OUT}" "${content}")
  message(STATUS "lnFreeRTOS_structs: updated ${OUT}")
endif()
